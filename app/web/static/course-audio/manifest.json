    "bytes": 14544
  },
  "BK02-C02": {
    "text": "我最喜欢踢足球",
    "speaker": "B",
    "voice": "zh-CN-YunxiNeural",
    "rate": "-22%",
    "speech_text": "我最喜欢踢足球。",
    "url": "/static/course-audio/3ee8e91975b2e5b1c65b0e2cf1a614abf52a1890.mp3",
    "bytes": 19152
  },
