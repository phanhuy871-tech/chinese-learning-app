    "speech_text": "为什么？",
    "url": "/static/course-audio/78757e8e41824f9b5377e4818580ce7015a6f76f.mp3",
    "bytes": 11232
  },
  "BK01-C04": {
    "text": "九月的北京天气不冷不热",
    "speaker": "B",
    "voice": "zh-CN-YunxiNeural",
    "rate": "-22%",
    "speech_text": "九月的北京，天气不冷不热。",
